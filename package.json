{
  "name": "claude-code-zhcn",
  "displayName": "Claude Code 简体中文汉化",
  "description": "为 Claude Code for VS Code 提供简体中文界面汉化、版本检测与安全恢复。",
  "version": "2.0.4",
  "publisher": "claude-code-zhcn",
  "license": "MIT",
  "author": "membershipwu",
  "repository": {
    "type": "git",
    "url": "https://github.com/membershipwu/Claude-code-for-vs.git"
  },
  "bugs": {
    "url": "https://github.com/membershipwu/Claude-code-for-vs/issues"
  },
  "homepage": "https://github.com/membershipwu/Claude-code-for-vs#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "中文",
    "汉化",
    "简体中文",
    "i18n",
    "localization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeZhcn.apply",
        "title": "应用汉化",
        "category": "Claude Code 汉化"
      },
      {
        "command": "claudeCodeZhcn.restore",
        "title": "还原英文原版",
        "category": "Claude Code 汉化"
      },
      {
        "command": "claudeCodeZhcn.status",
        "title": "检查状态",
        "category": "Claude Code 汉化"
      },
      {
        "command": "claudeCodeZhcn.resetSnapshot",
        "title": "重置英文快照（扩展升级后使用）",
        "category": "Claude Code 汉化"
      },
      {
        "command": "claudeCodeZhcn.openReport",
        "title": "打开汉化报告",
        "category": "Claude Code 汉化"
      },
      {
        "command": "claudeCodeZhcn.openSettings",
        "title": "打开设置",
        "category": "Claude Code 汉化"
      }
    ],
    "configuration": {
      "title": "Claude Code 汉化",
      "properties": {
        "claudeCodeZhcn.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "启动时检查 Claude Code 版本：若发现版本变化或汉化未应用，在状态栏提示（不会自动改写文件）。"
        },
        "claudeCodeZhcn.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 Claude Code 汉化状态。"
        },
        "claudeCodeZhcn.notifyOnApply": {
          "type": "boolean",
          "default": true,
          "description": "应用或还原完成后弹出通知，并提供“立即重新加载窗口”按钮。"
        },
        "claudeCodeZhcn.claudeCodeExtensionId": {
          "type": "string",
          "default": "Anthropic.claude-code",
          "description": "Claude Code 扩展 ID（用于定位安装目录）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node tools/build.js",
    "test": "node tools/verify.js",
    "smoke": "node tools/extension-smoke.js",
    "selftest": "node tools/selftest.js",
    "verify": "node tools/verify.js",
    "package": "npx --yes @vscode/vsce@^3 package --no-dependencies --out claude-code-zhcn-2.0.4.vsix"
  }
}
